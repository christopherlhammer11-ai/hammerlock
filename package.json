{
  "name": "hammerlock",
  "version": "0.4.0",
  "description": "🔨🔐 HammerLock AI — your AI, your data, your rules. Privacy-first intelligence with local encryption and zero cloud dependency.",
  "type": "module",
  "author": {
    "name": "HammerLock AI",
    "email": "support@hammerlockai.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "main": "electron/main.js",
  "bin": {
    "hammerlock": "bin/hammerlock.js"
  },
  "scripts": {
    "setup": "./scripts/install.sh",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node .next/standalone/server.js",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --mac --win --linux",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@noble/hashes": "^1.8.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.400.0",
    "next": "16.3.0",
    "openai": "^6.19.0",
    "openclaw": "2026.8.1-beta.1",
    "pdf-parse": "^2.4.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.2",
    "undici": "8.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.2",
    "@types/react": "19.2.18",
    "electron": "^43.3.0",
    "electron-builder": "^26.7.0",
    "eslint": "^10.0.2",
    "eslint-config-next": "^16.3.0",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.hammerlock.app",
    "productName": "HammerLock AI",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "app/**/*",
      "lib/**/*",
      "public/**/*",
      "bin/**/*",
      "templates/**/*",
      "scripts/**/*",
      ".next/**/*",
      "next.config.js",
      "tsconfig.json",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/HISTORY*",
      "!node_modules/**/README*",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/example*/**",
      "!node_modules/**/.github/**",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/lucide-react/dist/esm/**",
      "!node_modules/@next/swc-linux-*",
      "!node_modules/@next/swc-win32-*",
      "!node_modules/@next/swc-freebsd*"
    ],
    "mac": {
      "target": "dmg",
      "artifactName": "HammerLock-AI.${ext}",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "Christopher Hammer (89Q438GN53)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "HammerLock AI uses your microphone for voice input and live conversation mode.",
        "NSCalendarsUsageDescription": "HammerLock AI reads and creates calendar events so your AI assistant can manage your schedule.",
        "NSCalendarsFullAccessUsageDescription": "HammerLock AI reads and creates calendar events so your AI assistant can manage your schedule.",
        "NSRemindersUsageDescription": "HammerLock AI creates and manages reminders so your AI assistant can help you stay on track.",
        "NSRemindersFullAccessUsageDescription": "HammerLock AI creates and manages reminders so your AI assistant can help you stay on track.",
        "NSContactsUsageDescription": "HammerLock AI accesses your contacts to help send messages, emails, and personalize your experience.",
        "NSAppleEventsUsageDescription": "HammerLock AI uses Apple Events to interact with Calendar, Notes, Reminders, and other apps on your behalf.",
        "NSDesktopFolderUsageDescription": "HammerLock AI may access files on your Desktop when you ask it to read or analyze documents.",
        "NSDocumentsFolderUsageDescription": "HammerLock AI may access files in your Documents folder when you ask it to read or analyze documents.",
        "NSDownloadsFolderUsageDescription": "HammerLock AI may access your Downloads folder when you ask it to process downloaded files."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      },
      "icon": "build/icon.icns",
      "iconSize": 80,
      "background": null
    },
    "win": {
      "target": "nsis",
      "icon": "public/hammerlock-logo.png",
      "artifactName": "HammerLock-AI-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "HammerLock-AI-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/hammerlock-logo.png",
      "category": "Office",
      "artifactName": "HammerLock-AI.${ext}",
      "synopsis": "Local-first AI with encrypted memory",
      "description": "HammerLock AI — Your AI. Your Data. Your Rules."
    }
  },
  "overrides": {
    "@types/react": "19.2.18"
  }
}
